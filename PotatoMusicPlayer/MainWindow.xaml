<Window x:Class="PotatoMusicPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Potato Music Player"
        Width="900" Height="480"
        MinWidth="500" MinHeight="440"
        Background="{DynamicResource SurfaceWindowBrush}"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="False">

    <Window.Resources>
        <DrawingImage x:Key="TaskbarPreviousIcon">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="{DynamicResource TextPrimaryBrush}" Geometry="M 1,1 L 1,15 L 4,15 L 4,1 Z M 6,8 L 15,1 L 15,15 Z"/>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="TaskbarPlayIcon">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="{DynamicResource TextPrimaryBrush}" Geometry="M 3,1 L 15,8 L 3,15 Z"/>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="TaskbarPauseIcon">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="{DynamicResource TextPrimaryBrush}" Geometry="M 2,1 L 6,1 L 6,15 L 2,15 Z M 10,1 L 14,1 L 14,15 L 10,15 Z"/>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="TaskbarNextIcon">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="{DynamicResource TextPrimaryBrush}" Geometry="M 1,1 L 10,8 L 1,15 Z M 12,1 L 12,15 L 15,15 L 15,1 Z"/>
            </DrawingImage.Drawing>
        </DrawingImage>
    </Window.Resources>

    <Window.TaskbarItemInfo>
        <shell:TaskbarItemInfo x:Name="TaskbarInfo" Description="Potato Music Player">
            <shell:TaskbarItemInfo.ThumbButtonInfos>
                <shell:ThumbButtonInfo x:Name="TaskbarPreviousButton" Description="Previous" ImageSource="{StaticResource TaskbarPreviousIcon}" Click="TaskbarPrevious_Click"/>
                <shell:ThumbButtonInfo x:Name="TaskbarPlayPauseButton" Description="Play / Pause" ImageSource="{StaticResource TaskbarPlayIcon}" Click="TaskbarPlayPause_Click"/>
                <shell:ThumbButtonInfo x:Name="TaskbarNextButton" Description="Next" ImageSource="{StaticResource TaskbarNextIcon}" Click="TaskbarNext_Click"/>
            </shell:TaskbarItemInfo.ThumbButtonInfos>
        </shell:TaskbarItemInfo>
    </Window.TaskbarItemInfo>

    <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1">
        <Grid x:Name="RootGrid">
            <!-- すりガラス時のヒットテスト用全面プレート(最背面。操作の貫通防止) -->
            <Border x:Name="HitTestPlate" Background="{DynamicResource HitTestPlateBrush}" Visibility="Collapsed"/>
            <!-- ============ メインコンテンツ(サイドバーオープン時はぼかし+減光) ============ -->
            <Grid x:Name="MainContentGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- カスタムタイトルバー -->
                    <RowDefinition Height="Auto"/>
                    <!-- メタデータ表示 -->
                    <RowDefinition x:Name="WaveformRow" Height="192"/>
                    <!-- 波形表示(縦に拡大) -->
                    <RowDefinition Height="Auto"/>
                    <!-- 時間 / 再生バー -->
                    <RowDefinition Height="Auto"/>
                    <!-- プレイリスト枠(再生中のみ) -->
                    <RowDefinition x:Name="SpectrumRow" Height="60"/>
                    <!-- スペクトラムアナライザ -->
                    <RowDefinition Height="*"/>
                    <!-- 伸縮スペーサー -->
                    <RowDefinition Height="Auto"/>
                    <!-- トランスポートコントロール(下端に固定) -->
                </Grid.RowDefinitions>


                <!-- ============ タイトルバー(Web風: ハンバーガー + ドラッグ領域 + 窓ボタン) ============ -->
                <!-- 背景差し替え式にするため Grid を MaterialAppBarBorderStyle の Border で包む。
                     将来のぼかし導入時はこの Border の Background/Effect だけ変える。 -->
                <Border Grid.Row="0" Style="{StaticResource MaterialAppBarBorderStyle}"
                        Background="{DynamicResource TitleBarGradientBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- サイドバー開閉ボタン -->
                        <Button x:Name="MenuToggleButton" Grid.Column="0" Content="☰" Width="34" Height="26"
                                Style="{StaticResource WindowControlButtonStyle}" Background="Transparent"
                                Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" FontSize="13"
                                VerticalAlignment="Center" Click="MenuToggle_Click"/>

                        <!-- アイコン領域はドラッグ可能なタイトルバー領域としても使用する -->
                        <Border Grid.Column="1" Padding="8,0,6,0" Background="Transparent"
                                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="pack://application:,,,/Resources/Icons/potato.png" Width="16" Height="16"
                                       Stretch="Uniform" SnapsToDevicePixels="True"/>
                            </StackPanel>
                        </Border>

                        <!-- 操作ボタンと重ならないドラッグ専用領域 -->
                        <Border Grid.Column="2" Background="Transparent"
                                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>

                        <!-- 最小化・閉じるボタン -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button Content="—" Width="32" Height="26" Style="{StaticResource WindowControlButtonStyle}" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                                    BorderThickness="0" Click="Minimize_Click"/>
                            <Button Content="✕" Width="32" Height="26" Style="{StaticResource CloseButtonStyle}" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                                    BorderThickness="0" Click="Close_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============ メタデータ表示 ============ -->
                <StackPanel Grid.Row="1" Margin="8,4,8,2">
                    <TextBlock x:Name="TitleText" Text="再生するファイルがありません" Style="{StaticResource TitleTextStyle}"/>
                    <TextBlock x:Name="ArtistText" Text="" Style="{StaticResource SubTextStyle}"/>
                </StackPanel>

                <!-- ============ 波形表示エリア ============ -->
                <Grid Grid.Row="2" Margin="8,2,8,2">
                    <!-- 時刻表示と同じ列幅を確保し、波形の左右端をシークバーに揃える -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="00:00" Foreground="Transparent"
                               FontFamily="Consolas" FontSize="10" Margin="0,0,6,0"/>
                    <Border x:Name="WaveformContainer" Grid.Column="1"
                            Background="{DynamicResource WaveformBackgroundGradientBrush}"
                            CornerRadius="{StaticResource MaterialCornerSmall}" ClipToBounds="True">
                        <Grid>
                            <Canvas x:Name="WaveformCanvas" Background="Transparent" ClipToBounds="True"
                                    PreviewMouseWheel="WaveformCanvas_PreviewMouseWheel"
                                    PreviewMouseLeftButtonDown="WaveformCanvas_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="WaveformCanvas_PreviewMouseMove"
                                    PreviewMouseLeftButtonUp="WaveformCanvas_PreviewMouseLeftButtonUp"
                                    PreviewMouseRightButtonDown="WaveformCanvas_PreviewMouseRightButtonDown"
                                    PreviewMouseRightButtonUp="WaveformCanvas_PreviewMouseRightButtonUp"
                                    LostMouseCapture="WaveformCanvas_LostMouseCapture"
                                    SizeChanged="WaveformCanvas_SizeChanged"/>
                            <TextBlock x:Name="WaveformProgressText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Visibility="Collapsed" IsHitTestVisible="False"/>
                            <TextBlock x:Name="EngineLoadingText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="WaveformRangeText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-13,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Cursor="Hand"
                               MouseLeftButtonUp="WaveformRangeText_MouseLeftButtonUp"/>
                    <TextBlock Grid.Column="2" Text="00:00" Foreground="Transparent"
                               FontFamily="Consolas" FontSize="10" Margin="6,0,0,0"/>
                </Grid>

                <!-- ============ 時間表示 / 再生バー ============ -->
                <Grid Grid.Row="3" Margin="8,2,8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="MinimapRow" Height="18"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="CurrentTimeText" Grid.Row="0" Grid.Column="0" Text="00:00" Style="{StaticResource TimeTextStyle}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>

                    <Slider x:Name="SeekBar" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="100" Value="0"
                            Style="{StaticResource MaterialSliderStyle}"
                            VerticalAlignment="Center"
                            PreviewMouseLeftButtonDown="SeekBar_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="SeekBar_PreviewMouseMove"
                            PreviewMouseLeftButtonUp="SeekBar_PreviewMouseLeftButtonUp"/>

                    <TextBlock x:Name="TotalTimeText" Grid.Row="0" Grid.Column="2" Text="00:00" Style="{StaticResource TimeTextStyle}"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>

                    <Border x:Name="MinimapContainer" Grid.Row="2" Grid.Column="1" Margin="0,2,0,0"
                            Background="{DynamicResource MinimapBackgroundGradientBrush}"
                            CornerRadius="{StaticResource MaterialCornerExtraSmall}" ClipToBounds="True">
                        <Canvas x:Name="MinimapCanvas" Background="Transparent" ClipToBounds="True"
                                PreviewMouseLeftButtonDown="MinimapCanvas_PreviewMouseLeftButtonDown"
                                PreviewMouseMove="MinimapCanvas_PreviewMouseMove"
                                PreviewMouseLeftButtonUp="MinimapCanvas_PreviewMouseLeftButtonUp"
                                LostMouseCapture="MinimapCanvas_LostMouseCapture"
                                SizeChanged="MinimapCanvas_SizeChanged"/>
                    </Border>

                    <!-- 全体波形ビューのモード切替: リピート編集 / ビュー範囲 -->
                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="MinimapModeSwitch" Grid.Column="0"
                                      Style="{StaticResource MinimapModeSwitchStyle}"
                                      VerticalAlignment="Center"
                                      Click="MinimapModeSwitch_Click"/>
                        <TextBlock x:Name="RepeatRangeLabel" Grid.Column="1" Text="範囲未選択"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"
                                   FontFamily="Consolas" VerticalAlignment="Center" Margin="8,0"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox x:Name="RepeatEndBehaviorCombo" Width="76" FontSize="10"
                                      Style="{StaticResource ComboBoxStyle}"
                                      SelectionChanged="RepeatEndBehaviorCombo_SelectionChanged">
                                <ComboBoxItem x:Name="RepeatLoopItem" Content="ループ" Tag="Loop"/>
                                <ComboBoxItem x:Name="RepeatStopItem" Content="停止" Tag="StopAtEnd"/>
                            </ComboBox>
                            <Button x:Name="RepeatRangeClearButton" Content="クリア" FontSize="10"
                                    Style="{StaticResource SettingsInputButtonStyle}"
                                    Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}"
                                    BorderBrush="Transparent" BorderThickness="1" Padding="4,1" Margin="4,0,0,0"
                                    Click="RepeatRangeClearButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ============ プレイリスト枠(左: 一覧 / 右: プロパティ) ============ -->
                <Grid x:Name="PlaylistPanesContainer" Grid.Row="4" Margin="8,2,8,2" Height="128" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Margin="0,0,4,0" Background="{DynamicResource SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource MaterialCornerSmall}" ClipToBounds="True" Padding="0,0,0,2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ListBox x:Name="PlaylistTrackList" Grid.Row="0" Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11"
                                 DisplayMemberPath="FileName"
                                 SelectionChanged="PlaylistTrackList_SelectionChanged"
                                 MouseDoubleClick="PlaylistTrackList_DoubleClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="8,3"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                            <CheckBox x:Name="PlaylistContinuousCheck" Grid.Row="1" Content="連続で流す" FontSize="11"
                                      Foreground="{DynamicResource TextPrimaryBrush}" Margin="8,2,0,0"
                                      VerticalAlignment="Center"
                                      Checked="PlaylistContinuousCheck_Changed" Unchecked="PlaylistContinuousCheck_Changed"/>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Margin="4,0,0,0" Background="{DynamicResource SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource MaterialCornerSmall}" ClipToBounds="True" Padding="8,4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PropTitleLabel" Grid.Row="0" Grid.Column="0" Text="タイトル" Style="{StaticResource MaterialCaptionTextStyle}"/>
                                <TextBlock x:Name="PropTitleValue" Grid.Row="0" Grid.Column="1" Style="{StaticResource MaterialCaptionTextStyle}" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="PropFileLabel" Grid.Row="1" Grid.Column="0" Text="ファイル名" Style="{StaticResource MaterialCaptionTextStyle}"/>
                                <TextBlock x:Name="PropFileValue" Grid.Row="1" Grid.Column="1" Style="{StaticResource MaterialCaptionTextStyle}" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                <TextBlock x:Name="PropSizeLabel" Grid.Row="2" Grid.Column="0" Text="サイズ" Style="{StaticResource MaterialCaptionTextStyle}"/>
                                <TextBlock x:Name="PropSizeValue" Grid.Row="2" Grid.Column="1" Style="{StaticResource MaterialCaptionTextStyle}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="PropLengthLabel" Grid.Row="3" Grid.Column="0" Text="長さ" Style="{StaticResource MaterialCaptionTextStyle}"/>
                                <TextBlock x:Name="PropLengthValue" Grid.Row="3" Grid.Column="1" Style="{StaticResource MaterialCaptionTextStyle}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="PropAddedLabel" Grid.Row="4" Grid.Column="0" Text="追加日時" Style="{StaticResource MaterialCaptionTextStyle}"/>
                                <TextBlock x:Name="PropAddedValue" Grid.Row="4" Grid.Column="1" Style="{StaticResource MaterialCaptionTextStyle}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="PropLocationLabel" Grid.Row="5" Grid.Column="0" Text="場所" Style="{StaticResource MaterialCaptionTextStyle}"/>
                                <TextBlock x:Name="PropLocationValue" Grid.Row="5" Grid.Column="1" Style="{StaticResource MaterialCaptionTextStyle}" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                <TextBlock x:Name="PropBitrateLabel" Grid.Row="6" Grid.Column="0" Text="ビットレート" Style="{StaticResource MaterialCaptionTextStyle}"/>
                                <TextBlock x:Name="PropBitrateValue" Grid.Row="6" Grid.Column="1" Style="{StaticResource MaterialCaptionTextStyle}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ============ スペクトラムアナライザ(画面下) ============ -->
                <Grid Grid.Row="5" Margin="8,4,8,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="00:00" Foreground="Transparent"
                               FontFamily="Consolas" FontSize="10" Margin="0,0,6,0"/>
                    <Border x:Name="SpectrumContainer" Grid.Column="1"
                            Background="{DynamicResource WaveformBackgroundGradientBrush}"
                            CornerRadius="{StaticResource MaterialCornerSmall}" ClipToBounds="True">
                        <Canvas x:Name="SpectrumCanvas" Background="Transparent" ClipToBounds="True"
                                IsHitTestVisible="False"
                                SizeChanged="SpectrumCanvas_SizeChanged"/>
                    </Border>
                    <TextBlock Grid.Column="2" Text="00:00" Foreground="Transparent"
                               FontFamily="Consolas" FontSize="10" Margin="6,0,0,0"/>
                </Grid>

                <!-- ============ トランスポートコントロール(下端に固定) ============ -->
                <Grid Grid.Row="7" Margin="8,2,8,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左: 速度・ループ表示 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock x:Name="SpeedText" Text="1.0x" Style="{StaticResource TimeTextStyle}" Margin="4,0" VerticalAlignment="Center"/>
                        <Button x:Name="LoopButton" Content="Loop: OFF" Style="{StaticResource SettingsInputButtonStyle}" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}"
                                BorderBrush="Transparent" BorderThickness="1" FontSize="10" Padding="4,1" Click="ToggleLoop_Click"/>
                    </StackPanel>

                    <!-- 中央: 再生系ボタン(図形描画アイコン) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="PrevButton" Style="{StaticResource MaterialFlatButtonStyle}" Margin="4,0" Click="GoToStart_Click">
                            <Path Data="M2,2 H4.5 V14 H2 Z M13.5,2 L6,8 L13.5,14 Z" Width="18" Height="18" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button x:Name="PlayPauseButton" Style="{StaticResource MaterialFilledButtonStyle}" Margin="8,0"
                                Background="{DynamicResource AccentGradientBrush}" Effect="{DynamicResource AccentGlowEffect}"
                                Click="PlayPause_Click">
                            <Grid Width="22" Height="22">
                                <Path x:Name="PlayIconPath" Data="M4,2 L13,8 L4,14 Z" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      RenderTransformOrigin="0.5,0.5" Opacity="1">
                                    <Path.RenderTransform>
                                        <ScaleTransform x:Name="PlayIconScale" ScaleX="1" ScaleY="1"/>
                                    </Path.RenderTransform>
                                </Path>
                                <Path x:Name="PauseIconPath" Data="M3.5,2 H6.5 V14 H3.5 Z M9.5,2 H12.5 V14 H9.5 Z" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      RenderTransformOrigin="0.5,0.5" Opacity="0">
                                    <Path.RenderTransform>
                                        <ScaleTransform x:Name="PauseIconScale" ScaleX="0.7" ScaleY="0.7"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                        </Button>
                        <Button x:Name="StopButton" Style="{StaticResource MaterialFlatButtonStyle}" Margin="4,0" Click="Stop_Click">
                            <Path Data="M3.5,3.5 H12.5 V12.5 H3.5 Z" Width="16" Height="16" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button x:Name="NextButton" Style="{StaticResource MaterialFlatButtonStyle}" Margin="4,0" Click="Stop_Click">
                            <Path Data="M11.5,2 H14 V14 H11.5 Z M2.5,2 L10,8 L2.5,14 Z" Width="18" Height="18" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                    </StackPanel>

                    <!-- 右: 音量 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                MouseWheel="VolumeArea_MouseWheel">
                        <Image x:Name="VolumeIcon" Source="pack://application:,,,/Resources/Icons/speaker_dark_3.png"
                               Width="16" Height="16" Stretch="Uniform" Margin="0,0,4,0"
                               ToolTip="ミュート切り替え" Cursor="Hand"
                               MouseLeftButtonUp="VolumeIcon_MouseLeftButtonUp"/>
                        <Slider x:Name="VolumeSlider" Width="70" Height="18" Minimum="0" Maximum="200" Value="80"
                                Style="{StaticResource MaterialSliderStyle}"
                                VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"
                                PreviewMouseLeftButtonDown="VolumeSlider_PreviewMouseLeftButtonDown"
                                PreviewMouseMove="VolumeSlider_PreviewMouseMove"
                                PreviewMouseLeftButtonUp="VolumeSlider_PreviewMouseLeftButtonUp"
                                LostMouseCapture="VolumeSlider_LostMouseCapture"/>
                        <TextBlock x:Name="VolumeText" Text="80%" Style="{StaticResource TimeTextStyle}" Margin="6,0,0,0" VerticalAlignment="Center" Width="26" TextAlignment="Right"/>
                    </StackPanel>
                </Grid>

                <!-- ============ ホーム画面(タイトルバーは残し、コンテンツ行のみ覆う) ============ -->
                <Grid x:Name="HomeOverlay" Grid.Row="1" Grid.RowSpan="7"
                        Background="Transparent" Visibility="Visible">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="HomeOverlaySlide" Y="0"/>
                    </Grid.RenderTransform>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
                        <Image Source="pack://application:,,,/Resources/Icons/potato.png" Width="64" Height="64"
                               Stretch="Uniform" SnapsToDevicePixels="True" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock x:Name="HomeTitleText" Text="Potato Music Player" Style="{StaticResource MaterialHeadlineTextStyle}"
                                   HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock x:Name="HomeSubtitleText" Text="再生するファイルを選んでください" Style="{StaticResource MaterialCaptionTextStyle}"
                                   HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        <Button x:Name="HomeOpenButton" Content="ファイルを開く" FontSize="14" Height="44"
                                Style="{StaticResource SettingsInputButtonStyle}"
                                Background="{DynamicResource ApplyButtonBrush}" Foreground="{DynamicResource AccentButtonForegroundBrush}"
                                BorderBrush="{DynamicResource BorderControlBrush}" BorderThickness="1" Margin="0,0,0,8"
                                Click="HomeOpenButton_Click"/>
                        <Button x:Name="HomeSettingsButton" Content="設定..." FontSize="13" Height="40"
                                Style="{StaticResource SettingsInputButtonStyle}"
                                Background="{DynamicResource SurfaceControlBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                BorderBrush="{DynamicResource BorderControlBrush}" BorderThickness="1" Margin="0,0,0,8"
                                Click="HomeSettingsButton_Click"/>
                        <Button x:Name="HomePlaylistButton" Content="プレイリスト ウィザード" FontSize="13" Height="40"
                                Style="{StaticResource SettingsInputButtonStyle}"
                                Background="{DynamicResource SurfaceControlBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                BorderBrush="{DynamicResource BorderControlBrush}" BorderThickness="1" Margin="0,0,0,16"
                                Click="HomePlaylistButton_Click"/>
                        <TextBlock x:Name="HomeRecentHeader" Text="最近使ったファイル" Style="{StaticResource MaterialCaptionTextStyle}"
                                   Margin="4,0,0,4"/>
                        <StackPanel x:Name="HomeRecentFilesPanel" Margin="0,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ============ サイドバー用ディムオーバーレイ(背景減光・クリックで閉じる) ============ -->
            <Border x:Name="SidebarDimOverlay" Background="{DynamicResource SidebarDimBrush}" Opacity="0" Visibility="Collapsed"
                    MouseLeftButtonUp="SidebarDimOverlay_MouseLeftButtonUp" Panel.ZIndex="90"/>

            <!-- ============ サイドバー(Web風ドロワー: 左からスライド) ============ -->
            <Border x:Name="SidebarPanel" Width="280" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                    Background="{DynamicResource SurfacePanelBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,0,1,0"
                    Visibility="Collapsed" Panel.ZIndex="100"
                    Effect="{StaticResource MaterialElevation3Effect}">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="SidebarSlide" X="-280"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ドロワーヘッダー -->
                    <Border Grid.Row="0" Background="{DynamicResource TitleBarGradientBrush}" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SidebarMenuHeaderText" Grid.Column="0" Text="Potato Music Player" FontSize="14" FontWeight="Bold"
                                       Style="{StaticResource TitleTextStyle}" VerticalAlignment="Center"/>
                            <Button x:Name="SidebarCloseButton" Grid.Column="1" Content="✕" Width="28" Height="24"
                                    Style="{StaticResource WindowControlButtonStyle}" Background="Transparent"
                                    Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0"
                                    Click="SidebarCloseButton_Click"/>
                        </Grid>
                    </Border>

                    <!-- ドロワー本体(既定は全カテゴリー閉) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8,8,8,12">
                        <StackPanel>
                            <Expander x:Name="SidebarFileExpander" Header="ファイル" IsExpanded="False"
                                      Style="{StaticResource SidebarSectionExpanderStyle}"
                                      Foreground="{DynamicResource TextPrimaryBrush}">
                                <StackPanel>
                                    <Button x:Name="SidebarHomeButton" Content="ホーム" Click="GoHome_Click" Style="{StaticResource SidebarMenuButtonStyle}"/>
                                    <Button x:Name="SidebarOpenButton" Content="開く..." Click="OpenFile_Click" Style="{StaticResource SidebarMenuButtonStyle}"/>
                                    <Button x:Name="SidebarOpenLocationButton" Content="ファイルの場所を開く" Click="OpenFileLocation_Click" Style="{StaticResource SidebarMenuButtonStyle}"/>
                                    <Button x:Name="SidebarOpenTerminalButton" Content="ターミナルで開く" Click="OpenInTerminal_Click" Style="{StaticResource SidebarMenuButtonStyle}"/>
                                    <TextBlock x:Name="SidebarRecentHeader" Text="最近使ったファイル" Margin="12,8,12,2"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                    <StackPanel x:Name="SidebarRecentFilesPanel" Margin="4,0"/>
                                    <Button x:Name="SidebarClearRecentButton" Content="履歴をクリア" Click="ClearRecentFiles_Click" Style="{StaticResource SidebarMenuButtonStyle}"/>
                                    <Button x:Name="SidebarSettingsButton" Content="設定..." Click="OpenSettings_Click" Style="{StaticResource SidebarMenuButtonStyle}"/>
                                    <Button x:Name="SidebarExitButton" Content="終了" Click="Exit_Click" Style="{StaticResource SidebarMenuButtonStyle}"/>
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="SidebarPlaybackExpander" Header="再生" IsExpanded="False"
                                      Style="{StaticResource SidebarSectionExpanderStyle}"
                                      Foreground="{DynamicResource TextPrimaryBrush}">
                                <StackPanel>
                                    <Button x:Name="SidebarPlayPauseButton" Content="再生/一時停止" Click="PlayPause_Click" Style="{StaticResource SidebarMenuButtonStyle}"/>
                                    <Button x:Name="SidebarStopButton" Content="停止" Click="Stop_Click" Style="{StaticResource SidebarMenuButtonStyle}"/>
                                    <Button x:Name="SidebarGoToStartButton" Content="最初へ戻る" Click="GoToStart_Click" Style="{StaticResource SidebarMenuButtonStyle}"/>
                                    <Button x:Name="SidebarSeekToTimeButton" Content="指定時刻へ移動..." Click="SeekToTime_Click" Style="{StaticResource SidebarMenuButtonStyle}"/>
                                    <Button x:Name="SidebarSpeedResetButton" Content="速度: 100%にセット" Click="SpeedReset_Click" Style="{StaticResource SidebarMenuButtonStyle}"/>
                                    <Button x:Name="SidebarSpeedDecreaseButton" Content="速度: 5%遅く" Click="SpeedDecrease_Click" Style="{StaticResource SidebarMenuButtonStyle}"/>
                                    <Button x:Name="SidebarSpeedIncreaseButton" Content="速度: 5%速く" Click="SpeedIncrease_Click" Style="{StaticResource SidebarMenuButtonStyle}"/>
                                    <Button x:Name="SidebarSkipForwardButton" Content="5秒スキップ" Click="SkipForward_Click" Style="{StaticResource SidebarMenuButtonStyle}"/>
                                    <Button x:Name="SidebarSkipBackwardButton" Content="5秒戻る" Click="SkipBackward_Click" Style="{StaticResource SidebarMenuButtonStyle}"/>
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="SidebarViewExpander" Header="表示" IsExpanded="False"
                                      Style="{StaticResource SidebarSectionExpanderStyle}"
                                      Foreground="{DynamicResource TextPrimaryBrush}">
                                <StackPanel>
                                    <CheckBox x:Name="SidebarAlwaysOnTopCheck" Content="常に最前面" Margin="12,4"
                                              Foreground="{DynamicResource TextPrimaryBrush}" Click="SidebarAlwaysOnTop_Click"/>
                                    <CheckBox x:Name="SidebarFixWindowSizeCheck" Content="ウィンドウサイズ固定" Margin="12,4"
                                              Foreground="{DynamicResource TextPrimaryBrush}" Click="SidebarFixWindowSize_Click"/>
                                    <CheckBox x:Name="SidebarShowWaveformCheck" Content="波形を表示" Margin="12,4"
                                              Foreground="{DynamicResource TextPrimaryBrush}" Click="SidebarShowWaveform_Click"/>
                                    <CheckBox x:Name="SidebarShowSpectrumCheck" Content="スペクトラムを表示" Margin="12,4"
                                              Foreground="{DynamicResource TextPrimaryBrush}" Click="SidebarShowSpectrum_Click"/>
                                    <CheckBox x:Name="SidebarCenterFixedCheck" Content="再生ヘッドを中央に固定" Margin="12,4"
                                              Foreground="{DynamicResource TextPrimaryBrush}" Click="SidebarCenterFixed_Click"/>
                                    <CheckBox x:Name="SidebarFreeViewCheck" Content="ビューを自由化" Margin="12,4"
                                              Foreground="{DynamicResource TextPrimaryBrush}" Click="SidebarFreeView_Click"/>
                                    <Button x:Name="SidebarWaveformRangeButton" Content="範囲を指定して拡大..." Click="WaveformRange_Click" Style="{StaticResource SidebarMenuButtonStyle}"/>
                                    <Button x:Name="SidebarFullScreenButton" Content="全画面表示" Click="FullScreen_Click" Style="{StaticResource SidebarMenuButtonStyle}"/>
                                    <TextBlock x:Name="SidebarThemeLabel" Text="モード" Margin="12,8,12,2"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                    <RadioButton x:Name="SidebarThemeLightRadio" Content="ライト" Tag="Light" GroupName="SidebarTheme"
                                                 Margin="12,2" Foreground="{DynamicResource TextPrimaryBrush}" Click="SidebarTheme_Click"/>
                                    <RadioButton x:Name="SidebarThemeDarkRadio" Content="ダーク" Tag="Dark" GroupName="SidebarTheme"
                                                 Margin="12,2" Foreground="{DynamicResource TextPrimaryBrush}" Click="SidebarTheme_Click"/>
                                    <RadioButton x:Name="SidebarThemeAshRadio" Content="アッシュ" Tag="Ash" GroupName="SidebarTheme"
                                                 Margin="12,2" Foreground="{DynamicResource TextPrimaryBrush}" Click="SidebarTheme_Click"/>
                                    <RadioButton x:Name="SidebarThemeSystemRadio" Content="システム" Tag="System" GroupName="SidebarTheme"
                                                 Margin="12,2" Foreground="{DynamicResource TextPrimaryBrush}" Click="SidebarTheme_Click"/>
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="SidebarOtherExpander" Header="その他" IsExpanded="False"
                                      Style="{StaticResource SidebarSectionExpanderStyle}"
                                      Foreground="{DynamicResource TextPrimaryBrush}">
                                <StackPanel>
                                    <Button x:Name="SidebarAboutButton" Content="バージョン情報" Click="About_Click" Style="{StaticResource SidebarMenuButtonStyle}"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
