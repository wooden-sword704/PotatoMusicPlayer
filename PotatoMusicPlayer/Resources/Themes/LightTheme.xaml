<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ThemeStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>
<!-- ===================== カラーパレット =====================
     Material roles:
     - SurfaceWindow = 最背面の紙 / SurfacePanel = カード面 / SurfaceRaised = 持ち上げ面
     - AccentGreen = プライマリアクセント / AccentBlue = セカンダリアクセント -->
    <Color x:Key="SurfaceWindowColor">#F5F5F5</Color>
    <Color x:Key="SurfacePanelColor">#FFFFFF</Color>
    <Color x:Key="SurfaceRaisedColor">#E8E8E8</Color>
    <Color x:Key="BorderDefaultColor">#CFCFCF</Color>
    <Color x:Key="TextPrimaryColor">#1B1B1B</Color>
    <Color x:Key="TextSecondaryColor">#444746</Color>
    <Color x:Key="AccentGreenColor">#2E7D32</Color>
    <Color x:Key="AccentGreenHoverColor">#43A047</Color>
    <Color x:Key="WaveformColor">#1565C0</Color>
    <Color x:Key="ProgressBarColor">#2E7D32</Color>
    <Color x:Key="SurfaceControlColor">#FFFFFF</Color>
    <Color x:Key="BorderControlColor">#A8A8A8</Color>
    <Color x:Key="MenuHoverColor">#E4E7EC</Color>
    <Color x:Key="WaveformBackgroundColor">#E9E9E9</Color>
    <Color x:Key="CloseHoverColor">#D93025</Color>
    <Color x:Key="AccentBlueColor">#0B57D0</Color>
    <Color x:Key="ApplyButtonColor">#76B87A</Color>
    <Color x:Key="MinimapWaveformColor">#5F6368</Color>
    <Color x:Key="RangeOverlayColor">#C2E7C0</Color>
    <Color x:Key="RangeOverlayBorderColor">#2E7D32</Color>
    <Color x:Key="PlaybackCursorColor">#1B1B1B</Color>
    <Color x:Key="ScrollBarThumbColor">#C1C1C1</Color>
    <Color x:Key="ResetButtonBackgroundColor">#F0F0F0</Color>
    <Color x:Key="ResetButtonForegroundColor">#1B1B1B</Color>
    <Color x:Key="AccentButtonForegroundColor">#18351A</Color>
    <Color x:Key="PendingIndicatorColor">#8A5A00</Color>
    <Color x:Key="SidebarDimColor">#000000</Color>

    <!-- ===================== ブラシ ===================== -->
    <SolidColorBrush x:Key="SurfaceWindowBrush" Color="{StaticResource SurfaceWindowColor}"/>
    <SolidColorBrush x:Key="SurfacePanelBrush" Color="{StaticResource SurfacePanelColor}"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}"/>
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="{StaticResource BorderDefaultColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreenColor}"/>
    <SolidColorBrush x:Key="AccentGreenHoverBrush" Color="{StaticResource AccentGreenHoverColor}"/>
    <SolidColorBrush x:Key="WaveformBrush" Color="{StaticResource WaveformColor}"/>
    <SolidColorBrush x:Key="ProgressBarBrush" Color="{StaticResource ProgressBarColor}"/>
    <SolidColorBrush x:Key="SurfaceControlBrush" Color="{StaticResource SurfaceControlColor}"/>
    <SolidColorBrush x:Key="BorderControlBrush" Color="{StaticResource BorderControlColor}"/>
    <SolidColorBrush x:Key="MenuHoverBrush" Color="{StaticResource MenuHoverColor}"/>
    <SolidColorBrush x:Key="WaveformBackgroundBrush" Color="{StaticResource WaveformBackgroundColor}"/>
    <SolidColorBrush x:Key="CloseHoverBrush" Color="{StaticResource CloseHoverColor}"/>
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlueColor}"/>
    <SolidColorBrush x:Key="ApplyButtonBrush" Color="{StaticResource ApplyButtonColor}"/>
    <SolidColorBrush x:Key="MinimapWaveformBrush" Color="{StaticResource MinimapWaveformColor}"/>
    <SolidColorBrush x:Key="RangeOverlayBrush" Color="{StaticResource RangeOverlayColor}" Opacity="0.45"/>
    <SolidColorBrush x:Key="RangeOverlayBorderBrush" Color="{StaticResource RangeOverlayBorderColor}"/>
    <SolidColorBrush x:Key="PlaybackCursorBrush" Color="{StaticResource PlaybackCursorColor}"/>
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{StaticResource ScrollBarThumbColor}"/>
    <SolidColorBrush x:Key="ResetButtonBackgroundBrush" Color="{StaticResource ResetButtonBackgroundColor}"/>
    <SolidColorBrush x:Key="ResetButtonForegroundBrush" Color="{StaticResource ResetButtonForegroundColor}"/>
    <SolidColorBrush x:Key="AccentButtonForegroundBrush" Color="{StaticResource AccentButtonForegroundColor}"/>
    <SolidColorBrush x:Key="PendingIndicatorBrush" Color="{StaticResource PendingIndicatorColor}"/>
    <!-- すりガラス用の半透明色。ウィンドウ背景だけが透け、パネル類は不透明のまま。 -->
    <Color x:Key="GlassTintColor">#00F5F5F5</Color>
    <SolidColorBrush x:Key="GlassTintBrush" Color="{StaticResource GlassTintColor}"/>
    <SolidColorBrush x:Key="SidebarDimBrush" Color="{StaticResource SidebarDimColor}" Opacity="0.4"/>

    <!-- ===================== グラデーション・グロー =====================
         静的な面にのみ使用する。毎フレーム再描画される波形バー自体には付けない。 -->
    <LinearGradientBrush x:Key="TitleBarGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#E9E9E9" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WaveformBackgroundGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F2F2F2" Offset="0"/>
        <GradientStop Color="#E0E0E0" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MinimapBackgroundGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F4F4F4" Offset="0"/>
        <GradientStop Color="#E3E3E3" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#43A047" Offset="0"/>
        <GradientStop Color="#2E7D32" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ProgressGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#43A047" Offset="0"/>
        <GradientStop Color="#2E7D32" Offset="1"/>
    </LinearGradientBrush>
    <DropShadowEffect x:Key="AccentGlowEffect" Color="{StaticResource AccentGreenColor}" BlurRadius="16" ShadowDepth="0" Opacity="0.45"/>


</ResourceDictionary>
