<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Material motion tokens. Single place to tune every animation speed. -->
    <Duration x:Key="MaterialDurationInstant">0:0:0.05</Duration>
    <Duration x:Key="MaterialDurationFast">0:0:0.1</Duration>
    <Duration x:Key="MaterialDurationNormal">0:0:0.18</Duration>
    <Duration x:Key="MaterialDurationSlow">0:0:0.28</Duration>

    <!-- Easing shared by VisualState storyboards. -->
    <CubicEase x:Key="MaterialEaseOut" EasingMode="EaseOut" />
    <CubicEase x:Key="MaterialEaseInOut" EasingMode="EaseInOut" />
    <QuadraticEase x:Key="MaterialEasePress" EasingMode="EaseOut" />
</ResourceDictionary>
